// IDN CARE - ERD lengkap sesuai PRD final
// Bagian 1: skema inti (MVP). Bagian 2: pengembangan lanjutan (modul asrama dan komunikasi dua arah).
// Tempel seluruh isi file ini ke editor di dbdiagram.io

Project idn_care {
  database_type: 'MySQL'
  Note: 'Platform pelaporan dan aspirasi kampus'
}

Enum user_role {
  mahasiswa
  admin_sarpras
  admin_kemahasiswaan
  super_admin
}

// ================= BAGIAN 1: SKEMA INTI (MVP) =================

Table users {
  id bigint [pk, increment]
  user_code varchar(50) [unique, not null, note: 'ID untuk login']
  name varchar(255) [not null]
  password varchar(255) [not null]
  role user_role [not null, default: 'mahasiswa']
  unit_or_prodi varchar(255)
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: true]
  is_dorm_resident boolean [not null, default: false, note: 'dipakai modul asrama']
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table report_types {
  id bigint [pk, increment]
  code varchar(30) [unique, not null, note: 'fasilitas | aspirasi | pelanggaran']
  name varchar(100) [not null]
}

Table categories {
  id bigint [pk, increment]
  report_type_id bigint [not null]
  name varchar(150) [not null]
  is_active boolean [not null, default: true]
}

Table locations {
  id bigint [pk, increment]
  name varchar(150) [not null, note: 'satu level, tanpa hierarki']
  is_active boolean [not null, default: true]
}

Table reports {
  id bigint [pk, increment]
  ticket_no varchar(30) [unique, not null]
  reporter_id bigint [note: 'kosong untuk pelanggaran anonim']
  reporter_token varchar(100) [note: 'HMAC dari ID pengguna, hanya pelanggaran anonim']
  report_type_id bigint [not null]
  category_id bigint [not null]
  location_id bigint
  title varchar(150) [not null]
  description text [not null]
  incident_date date [note: 'khusus pelanggaran']
  related_party varchar(255) [note: 'khusus pelanggaran']
  status varchar(20) [not null, default: 'dikirim', note: 'dikirim | diverifikasi | diproses | selesai | ditolak']
  requested_visibility varchar(10) [not null, default: 'rahasia', note: 'umum | rahasia']
  visibility_status varchar(15) [not null, default: 'menunggu', note: 'menunggu | disetujui | ditolak']
  approved_visibility varchar(10)
  is_anonymous boolean [not null, default: false]
  assigned_unit varchar(20) [not null, note: 'sarpras | kemahasiswaan']
  rejected_reason text
  completed_at timestamp
  confirmed_at timestamp
  reopened_count tinyint [not null, default: 0]
  created_at timestamp
  updated_at timestamp

  indexes {
    (status, report_type_id, created_at)
    reporter_token
  }
}

Table report_attachments {
  id bigint [pk, increment]
  report_id bigint [not null]
  file_path varchar(255) [not null]
  kind varchar(15) [not null, note: 'before | after | evidence']
  uploaded_by bigint
  created_at timestamp
}

Table report_status_histories {
  id bigint [pk, increment]
  report_id bigint [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  note text
  changed_by bigint [note: 'kosong jika diubah pelapor anonim']
  created_at timestamp
}

Table activity_logs {
  id bigint [pk, increment]
  user_id bigint [note: 'kosong untuk pengiriman pelanggaran anonim']
  role varchar(30)
  action varchar(100) [not null]
  subject_type varchar(100)
  subject_id bigint
  old_values json
  new_values json
  ip_address varchar(45) [note: 'kosong untuk pelanggaran anonim']
  created_at timestamp
}

// Tabel bawaan Laravel (php artisan make:notifications-table)
Table notifications {
  id char(36) [pk]
  type varchar(255) [not null]
  notifiable_type varchar(255) [not null]
  notifiable_id bigint [not null]
  data text [not null]
  read_at timestamp
  created_at timestamp
  updated_at timestamp
}

// ================= BAGIAN 2: PENGEMBANGAN LANJUTAN =================

// Komunikasi dua arah dengan pelapor anonim
Table report_messages {
  id bigint [pk, increment]
  report_id bigint [not null]
  sender_side varchar(10) [not null, note: 'pelapor | admin']
  sender_id bigint [note: 'kosong untuk pelapor anonim']
  body text [not null]
  created_at timestamp
}

// Jadwal piket
Table piket_groups {
  id bigint [pk, increment]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]
}

Table piket_group_members {
  id bigint [pk, increment]
  piket_group_id bigint [not null]
  user_id bigint [not null]
}

Table piket_tasks {
  id bigint [pk, increment]
  name varchar(150) [not null]
  is_active boolean [not null, default: true]
}

Table piket_schedules {
  id bigint [pk, increment]
  piket_group_id bigint [not null]
  piket_task_id bigint [not null]
  user_id bigint [not null]
  duty_date date [not null]
  status varchar(20) [not null, default: 'terjadwal', note: 'terjadwal | selesai | dilewati | ditukar']
  proof_path varchar(255)
  verified_by bigint
}

Table piket_swaps {
  id bigint [pk, increment]
  schedule_id bigint [not null]
  requested_by bigint [not null]
  requested_to bigint [not null]
  status varchar(15) [not null, default: 'menunggu', note: 'menunggu | disetujui | ditolak']
  created_at timestamp
}

// Booking fasilitas bersama
Table facilities {
  id bigint [pk, increment]
  name varchar(150) [not null, note: 'mesin cuci, dapur, ruang belajar']
  open_time time
  close_time time
  slot_minutes smallint
  capacity smallint
  is_active boolean [not null, default: true]
}

Table bookings {
  id bigint [pk, increment]
  facility_id bigint [not null]
  user_id bigint [not null]
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  status varchar(20) [not null, default: 'aktif', note: 'aktif | dibatalkan | selesai | tidak_hadir']
  cancel_reason varchar(255)
}

Table facility_blocks {
  id bigint [pk, increment]
  facility_id bigint [not null]
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  reason varchar(255)
  created_by bigint [not null]
}

// Papan pengumuman
Table announcements {
  id bigint [pk, increment]
  title varchar(200) [not null]
  body text [not null]
  category varchar(50)
  attachment_path varchar(255)
  is_pinned boolean [not null, default: false]
  show_from timestamp
  show_until timestamp
  created_by bigint [not null]
}

Table announcement_reads {
  id bigint [pk, increment]
  announcement_id bigint [not null]
  user_id bigint [not null]
  read_at timestamp
}

// Kas asrama
Table dues {
  id bigint [pk, increment]
  name varchar(150) [not null]
  amount decimal(12,2) [not null]
  period varchar(30)
  due_date date
  created_by bigint [not null]
}

Table due_payments {
  id bigint [pk, increment]
  due_id bigint [not null]
  user_id bigint [not null]
  status varchar(25) [not null, default: 'belum', note: 'belum | menunggu_verifikasi | lunas']
  proof_path varchar(255)
  verified_by bigint
  paid_at timestamp
}

Table cash_transactions {
  id bigint [pk, increment]
  type varchar(10) [not null, note: 'masuk | keluar']
  amount decimal(12,2) [not null]
  description varchar(255) [not null]
  receipt_path varchar(255)
  transacted_at timestamp [not null]
  due_payment_id bigint
  created_by bigint [not null]
  voided_at timestamp [note: 'transaksi tidak dihapus, hanya dibatalkan']
  void_reason varchar(255)
  voided_by bigint
}

// ================= RELASI =================

Ref: categories.report_type_id > report_types.id
Ref: reports.reporter_id > users.id
Ref: reports.report_type_id > report_types.id
Ref: reports.category_id > categories.id
Ref: reports.location_id > locations.id
Ref: report_attachments.report_id > reports.id [delete: cascade]
Ref: report_attachments.uploaded_by > users.id
Ref: report_status_histories.report_id > reports.id [delete: cascade]
Ref: report_status_histories.changed_by > users.id
Ref: activity_logs.user_id > users.id

Ref: report_messages.report_id > reports.id [delete: cascade]
Ref: report_messages.sender_id > users.id

Ref: piket_group_members.piket_group_id > piket_groups.id
Ref: piket_group_members.user_id > users.id
Ref: piket_schedules.piket_group_id > piket_groups.id
Ref: piket_schedules.piket_task_id > piket_tasks.id
Ref: piket_schedules.user_id > users.id
Ref: piket_schedules.verified_by > users.id
Ref: piket_swaps.schedule_id > piket_schedules.id
Ref: piket_swaps.requested_by > users.id
Ref: piket_swaps.requested_to > users.id

Ref: bookings.facility_id > facilities.id
Ref: bookings.user_id > users.id
Ref: facility_blocks.facility_id > facilities.id
Ref: facility_blocks.created_by > users.id

Ref: announcements.created_by > users.id
Ref: announcement_reads.announcement_id > announcements.id
Ref: announcement_reads.user_id > users.id

Ref: dues.created_by > users.id
Ref: due_payments.due_id > dues.id
Ref: due_payments.user_id > users.id
Ref: due_payments.verified_by > users.id
Ref: cash_transactions.due_payment_id > due_payments.id
Ref: cash_transactions.created_by > users.id
Ref: cash_transactions.voided_by > users.id

// ================= PENGELOMPOKAN =================

TableGroup akun {
  users
}

TableGroup referensi {
  report_types
  categories
  locations
}

TableGroup laporan {
  reports
  report_attachments
  report_status_histories
}

TableGroup pengawasan {
  activity_logs
  notifications
}

TableGroup lanjutan_komunikasi {
  report_messages
}

TableGroup lanjutan_piket {
  piket_groups
  piket_group_members
  piket_tasks
  piket_schedules
  piket_swaps
}

TableGroup lanjutan_fasilitas {
  facilities
  bookings
  facility_blocks
}

TableGroup lanjutan_pengumuman {
  announcements
  announcement_reads
}

TableGroup lanjutan_kas {
  dues
  due_payments
  cash_transactions
}
