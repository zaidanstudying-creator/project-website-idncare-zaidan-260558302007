
Project idn_care {
  database_type: 'MySQL'
  Note: 'Platform pelaporan dan aspirasi kampus'
}

Enum user_role {
  mahasiswa
  admin_sarpras
  admin_kemahasiswaan
  super_admin
}

Table users {
  id bigint [pk, increment]
  user_code varchar(50) [unique, not null, note: 'ID untuk login']
  name varchar(255) [not null]
  password varchar(255) [not null]
  role user_role [not null, default: 'mahasiswa']
  unit_or_prodi varchar(255)
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: true]
  auth_version int [not null, default: 1, note: 'incremented to invalidate active sessions after password reset or deactivation']
  is_dorm_resident boolean [not null, default: false, note: 'disiapkan untuk modul asrama']
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table report_types {
  id bigint [pk, increment]
  code varchar(30) [unique, not null, note: 'fasilitas | aspirasi | pelanggaran']
  name varchar(100) [not null]
}

Table categories {
  id bigint [pk, increment]
  report_type_id bigint [not null]
  name varchar(150) [not null]
  is_active boolean [not null, default: true]
}

Table locations {
  id bigint [pk, increment]
  name varchar(150) [not null]
  is_active boolean [not null, default: true]
}

Table reports {
  id bigint [pk, increment]
  ticket_no varchar(30) [unique, not null]
  reporter_id bigint [note: 'kosong untuk pelanggaran anonim']
  reporter_token varchar(100) [note: 'HMAC dari ID pengguna, hanya pelanggaran anonim']
  report_type_id bigint [not null]
  category_id bigint [not null]
  location_id bigint
  title varchar(150) [not null]
  description text [not null]
  incident_date date [note: 'khusus pelanggaran']
  related_party varchar(255) [note: 'khusus pelanggaran']
  status varchar(20) [not null, default: 'dikirim', note: 'dikirim | diverifikasi | diproses | selesai | ditolak']
  requested_visibility varchar(10) [not null, default: 'rahasia', note: 'umum | rahasia']
  visibility_status varchar(15) [not null, default: 'menunggu', note: 'menunggu | disetujui | ditolak']
  approved_visibility varchar(10)
  is_anonymous boolean [not null, default: false]
  assigned_unit varchar(20) [not null, note: 'sarpras | kemahasiswaan']
  rejected_reason text
  completed_at timestamp
  confirmed_at timestamp
  reopened_count tinyint [not null, default: 0]
  academic_year varchar(20)
  archived_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (status, report_type_id, created_at)
    reporter_token
  }
}

Table report_attachments {
  id bigint [pk, increment]
  report_id bigint [not null]
  file_path varchar(255) [not null]
  kind varchar(15) [not null, note: 'before | after | evidence']
  uploaded_by bigint
  created_at timestamp
}

Table report_status_histories {
  id bigint [pk, increment]
  report_id bigint [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  note text
  changed_by bigint [note: 'kosong jika diubah pelapor anonim']
  created_at timestamp
}

Table activity_logs {
  id bigint [pk, increment]
  user_id bigint [note: 'kosong untuk pengiriman pelanggaran anonim']
  role varchar(30)
  action varchar(100) [not null]
  subject_type varchar(100)
  subject_id bigint
  old_values json
  new_values json
  ip_address varchar(45) [note: 'kosong untuk pelanggaran anonim']
  created_at timestamp
}

// Tabel bawaan Laravel (php artisan make:notifications-table)
Table notifications {
  id char(36) [pk]
  type varchar(255) [not null]
  notifiable_type varchar(255) [not null]
  notifiable_id bigint [not null]
  data text [not null]
  read_at timestamp
  created_at timestamp
  updated_at timestamp
}

// Relasi
Ref: categories.report_type_id > report_types.id
Ref: reports.reporter_id > users.id
Ref: reports.report_type_id > report_types.id
Ref: reports.category_id > categories.id
Ref: reports.location_id > locations.id
Ref: report_attachments.report_id > reports.id [delete: cascade]
Ref: report_attachments.uploaded_by > users.id
Ref: report_status_histories.report_id > reports.id [delete: cascade]
Ref: report_status_histories.changed_by > users.id
Ref: activity_logs.user_id > users.id

// Pengelompokan agar diagram rapi
TableGroup referensi {
  report_types
  categories
  locations
}

TableGroup laporan {
  reports
  report_attachments
  report_status_histories
}

TableGroup pengawasan {
  activity_logs
  notifications
}
